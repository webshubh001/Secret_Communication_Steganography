# ─── Flask ─────────────────────────────────────────────────────────────────────
# A strong random string (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-very-strong-random-secret-key-here

# ─── Encryption ────────────────────────────────────────────────────────────────
# Master secret used to protect per-session AES keys in the database.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=your-master-secret-for-key-protection

# ─── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use the default SQLite database at database/app.db
# DATABASE_URL=sqlite:///database/app.db

# ─── Face Recognition ──────────────────────────────────────────────────────────
# Euclidean distance threshold. Lower = stricter authentication.
# Range: 0.4 (very strict) to 0.8 (lenient). Default: 0.6
FACE_RECOGNITION_THRESHOLD=0.6

# ─── Flask Environment ─────────────────────────────────────────────────────────
FLASK_ENV=development
